# Image tag: a release such as 0.1.0, a minor line such as 0.1, or latest.
KEYHALL_VERSION=latest

# Address people type in the browser. Used for sign-in cookies and OAuth callbacks.
KEYHALL_URL=http://localhost:8787

# Only for caddy/: the domain Caddy requests a certificate for (DNS must point here).
KEYHALL_DOMAIN=keyhall.example.com

# Generate each with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Encrypts every stored credential. Keep a copy OUTSIDE this server: without it,
# a backup cannot be read.
KEYHALL_ENCRYPTION_KEY=

# false disables local (command) MCP connections, which run inside the container.
KEYHALL_ALLOW_STDIO=true

# Only for tailscale/: an auth key from https://login.tailscale.com/admin/settings/keys
TS_AUTHKEY=
