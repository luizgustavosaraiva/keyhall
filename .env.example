# Local development and source installs. For Docker, use deploy/.env.example.
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Encrypts stored credentials and secrets. Generate with: openssl rand -base64 32
KEYHALL_ENCRYPTION_KEY=
BETTER_AUTH_URL=http://127.0.0.1:8787
# Add http://localhost:5173 when running the panel with pnpm dev:web
TRUSTED_ORIGINS=http://127.0.0.1:8787,http://localhost:5173
DATABASE_PATH=../data/keyhall.db
HOST=127.0.0.1
PORT=8787
# false disables local (stdio) connections, which run commands on this machine
KEYHALL_ALLOW_STDIO=true
