{
  "name": "server",
  "private": true,
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=../.env dist/index.js",
    "typecheck": "tsc --noEmit",
    "auth:generate": "auth generate --config src/auth.ts --output src/db/auth-schema.ts -y",
    "admin:create": "tsx --env-file-if-exists=../.env src/scripts/create-admin.ts",
    "password:reset": "tsx --env-file-if-exists=../.env src/scripts/reset-password.ts",
    "key:rotate": "tsx --env-file-if-exists=../.env src/scripts/rotate-key.ts",
    "db:backup": "tsx --env-file-if-exists=../.env src/scripts/backup.ts",
    "db:generate": "drizzle-kit generate",
    "test": "node --test test/"
  },
  "dependencies": {
    "@better-auth/api-key": "^1.7.10",
    "@hono/node-server": "^2.1.5",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "better-auth": "^1.7.10",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "undici": "^7.30.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "auth": "^1.7.10",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
